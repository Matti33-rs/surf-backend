{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=surf;User=root;Password=;",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "InstanceName": "surf:"
  },
  "WhatsApp": {
    "VerifyToken": "",
    "AppSecret": "",
    "AccessToken": "",
    "PhoneNumberId": "",
    "ApiVersion": "v23.0"
  }
}
